{
  "NETWORK_FETCH_PROCS": [
    "curl",
    "wget",
    "fetch"
  ],
  "RARE_GATEWAY_PROCS": [
    "gost",
    "frpc",
    "frps",
    "superproxy",
    "ngrok",
    "nssocks",
    "chisel",
    "earthworm",
    "ew",
    "lcx",
    "reGeorg",
    "neo-reGeorg",
    "iodine",
    "iodined",
    "dnscat",
    "dnscat2",
    "dns2tcp",
    "dns2tcpd",
    "ncat",
    "socat",
    "msfconsole",
    "meterpreter"
  ],
  "INTERPRETER_NAMES": [
    "bash",
    "sh",
    "dash",
    "zsh",
    "ksh"
  ],
  "BEHAVIOR_PATTERNS": [
    {
      "label": "cron_persistence",
      "description": "编辑或安装 crontab，或向计划任务目录写入",
      "severity": "high",
      "query": {
        "bool": {
          "should": [
            {
              "wildcard": {
                "cmdline": "*crontab*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*/etc/cron*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*/var/spool/cron*"
              }
            }
          ],
          "minimum_should_match": 1
        }
      }
    },
    {
      "label": "dns_tunnel_tool",
      "description": "DNS 隧道工具进程 (iodine/dnscat2/dns2tcp)",
      "severity": "critical",
      "query": {
        "bool": {
          "should": [
            {
              "term": {
                "proc_name.keyword": "iodine"
              }
            },
            {
              "term": {
                "proc_name.keyword": "iodined"
              }
            },
            {
              "term": {
                "proc_name.keyword": "dnscat"
              }
            },
            {
              "term": {
                "proc_name.keyword": "dnscat2"
              }
            },
            {
              "term": {
                "proc_name.keyword": "dns2tcp"
              }
            },
            {
              "term": {
                "proc_name.keyword": "dns2tcpd"
              }
            },
            {
              "wildcard": {
                "cmdline": "*dnscat*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*iodine*-f*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*dns2tcp*"
              }
            }
          ],
          "minimum_should_match": 1
        }
      }
    },
    {
      "label": "dns_high_freq_suspicious",
      "description": "单主机 nslookup/dig/host 查询次数达到阈值",
      "severity": "medium",
      "query": {
        "bool": {
          "must": [
            {
              "terms": {
                "proc_name.keyword": [
                  "nslookup",
                  "dig",
                  "host"
                ]
              }
            }
          ]
        }
      },
      "post_filter": "_dns_tunnel_heuristic",
      "min_count_threshold": 50
    },
    {
      "label": "credential_harvest",
      "description": "命令读取或复制 SSH 私钥或 shadow 文件",
      "severity": "high",
      "query": {
        "bool": {
          "should": [
            {
              "wildcard": {
                "cmdline": "*/.ssh/id_rsa*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*/.ssh/id_ed25519*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*/etc/shadow*"
              }
            }
          ],
          "minimum_should_match": 1
        }
      }
    },
    {
      "label": "ssh_lateral_novel_target",
      "description": "SSH/SCP/rsync 到基线期间未见的内网目标",
      "severity": "high",
      "query": {
        "bool": {
          "must": [
            {
              "terms": {
                "proc_name.keyword": [
                  "ssh",
                  "scp",
                  "rsync",
                  "sftp"
                ]
              }
            }
          ]
        }
      },
      "post_filter": "_lateral_novel_dst"
    },
    {
      "label": "reverse_shell",
      "description": "反弹 Shell 模式 (bash -i, /dev/tcp, mkfifo, nc -e)",
      "severity": "critical",
      "query": {
        "bool": {
          "should": [
            {
              "wildcard": {
                "cmdline": "*bash -i*>& /dev/tcp*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*/dev/tcp/*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*mkfifo*/tmp/*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*nc*-e*/bin/*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*ncat*-e*/bin/*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*socat*exec*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*python*socket*connect*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*perl*socket*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*ruby*TCPSocket*"
              }
            }
          ],
          "minimum_should_match": 1
        }
      }
    },
    {
      "label": "port_listen_bind",
      "description": "端口监听/Bind Shell (nc -l, socat LISTEN, python http.server)",
      "severity": "high",
      "query": {
        "bool": {
          "should": [
            {
              "wildcard": {
                "cmdline": "*nc*-l*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*ncat*-l*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*socat*TCP-LISTEN*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*python*http.server*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*python*SimpleHTTPServer*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*python*-m*http*"
              }
            }
          ],
          "minimum_should_match": 1
        }
      }
    },
    {
      "label": "security_disable",
      "description": "关闭 SELinux、firewalld 或 ufw",
      "severity": "high",
      "query": {
        "bool": {
          "should": [
            {
              "wildcard": {
                "cmdline": "*setenforce 0*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*systemctl stop firewalld*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*systemctl disable firewalld*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*ufw disable*"
              }
            }
          ],
          "minimum_should_match": 1
        }
      }
    },
    {
      "label": "tunnel_proxy",
      "description": "隧道/代理工具 (ssh -R/-L/-D, chisel, frpc, ew, reGeorg)",
      "severity": "critical",
      "query": {
        "bool": {
          "should": [
            {
              "wildcard": {
                "cmdline": "*ssh*-R *"
              }
            },
            {
              "wildcard": {
                "cmdline": "*ssh*-L *"
              }
            },
            {
              "wildcard": {
                "cmdline": "*ssh*-D *"
              }
            },
            {
              "term": {
                "proc_name.keyword": "chisel"
              }
            },
            {
              "term": {
                "proc_name.keyword": "frpc"
              }
            },
            {
              "term": {
                "proc_name.keyword": "frps"
              }
            },
            {
              "term": {
                "proc_name.keyword": "ew"
              }
            },
            {
              "term": {
                "proc_name.keyword": "earthworm"
              }
            },
            {
              "wildcard": {
                "cmdline": "*chisel*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*frpc*-c*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*reGeorg*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*neo-reGeorg*"
              }
            }
          ],
          "minimum_should_match": 1
        }
      }
    },
    {
      "label": "data_exfil",
      "description": "可能的数据传输（归档或编码后上传、curl 上传、管道发送）",
      "severity": "high",
      "query": {
        "bool": {
          "should": [
            {
              "wildcard": {
                "cmdline": "*tar*|*curl*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*base64*|*curl*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*cat*|*nc *"
              }
            },
            {
              "wildcard": {
                "cmdline": "*> /dev/tcp*"
              }
            },
            {
              "wildcard": {
                "cmdline": "*curl*-T *"
              }
            },
            {
              "wildcard": {
                "cmdline": "*curl*--upload*"
              }
            }
          ],
          "minimum_should_match": 1
        }
      }
    }
  ]
}
